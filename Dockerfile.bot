FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    adb \
    curl \
    python3 \
    make \
    g++ \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY viber-bot/package*.json ./
RUN npm ci

COPY viber-bot/tsconfig.json ./
COPY viber-bot/src ./src/
COPY data ./data/

EXPOSE 3000

ENV PORT=3000
ENV NODE_ENV=production

CMD ["npm", "run", "start:api"]
