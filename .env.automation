# ---- Server ----
PORT=3001

# ---- ADB ----
# The instance is reachable here once ADB debugging is enabled in its settings.
# LDPlayer also exposes the same instance as emulator-5554; pin one and stay on it.
ANDROID_SERIAL=127.0.0.1:5555
ADB_BIN=
ADB_EXEC_TIMEOUT=120000

# ---- Appium ----
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_NEW_COMMAND_TIMEOUT=300
UI_WAIT_TIMEOUT=15000
ANDROID_INSTALL_TIMEOUT=180000

# ---- Viber ----
VIBER_PACKAGE=com.viber.voip
# Empty -> Appium resolves the launchable activity itself
VIBER_ACTIVITY=
VIBER_MESSAGES_DB=/data/data/com.viber.voip/databases/viber_messages

# ---- Monitor ----
MONITOR_POLL_INTERVAL=2000
MONITOR_STORE=data/messages.jsonl

# ---- Monitor webhook ----
# Leave MONITOR_WEBHOOK_URL empty to disable pushing; the monitor then only
# logs and appends to MONITOR_STORE.
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_SECRET=
MONITOR_WEBHOOK_TIMEOUT=10000
MONITOR_WEBHOOK_RETRIES=4
MONITOR_WEBHOOK_RETRY_DELAY=1000
MONITOR_WEBHOOK_DEAD_LETTER=data/webhook-failed.jsonl
MONITOR_WEBHOOK_INCOMING_ONLY=true
