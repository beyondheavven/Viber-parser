# KTOR SERVER
PORT=

# ANDROID_EMULATOR
# shmayro/dockerify-android ships only android-30 (Android 11, AOSP x86_64);
# the version is not configurable. Display and memory are, and follow
# LDPlayer's "Tablet" preset by default. WIDTHxHEIGHT / dpi / MB.
EMULATOR_SCREEN_RESOLUTION=
EMULATOR_SCREEN_DENSITY=
EMULATOR_RAM_SIZE=

# EMULATOR_PORTS
EMULATOR_ADB_PORT=
EMULATOR_VNC_PORT=

# ADB SETTINGS
ADB_HOST=
ADB_PORT=
ADB_CONNECT_RETRIES=

# FRIDA SETTINGS
FRIDA_HOST=
FRIDA_PORT=

# SUPABASE SETTINGS
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# RABBIT
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_URL=
RABBITMQ_EVENTS_QUEUE=
# USERS
# Auto-upload finished collect tasks to Supabase (true/false, default true)
USERS_AUTOSYNC=

# Viber configuration
VIBER_DEFAULT_PHONE=
VIBER_DEFAULT_COUNTRY=

