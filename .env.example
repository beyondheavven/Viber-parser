# KTOR SERVER
PORT=

# ANDROID_EMULATOR
EMULATOR_SCREEN_RESOLUTION=
EMULATOR_SCREEN_DENSITY=
EMULATOR_RAM_SIZE=

# NETWORK BINDING
BIND_IP=

# Google Play services (OpenGApps PICO) and Magisk root, installed on first
# boot by the emulator image. Viber's activation refuses a device with no
# Play Services.
GAPPS_SETUP=
ROOT_SETUP=

# EMULATOR_PORTS
EMULATOR_ADB_PORT=
EMULATOR_VNC_PORT=

# SCRCPY_WEB_PORT
SCRCPY_WEB_PORT=

# EMULATOR AGENT
# External IP of the VM. Screen links and instance ids (adbSerial) are built
# from it; without it they point at localhost, which the browser cannot open.
HOST_PUBLIC_IP=
VPS_AGENT_SECRET=

#APPIUM_PORT
APPIUM_PORT=

# ADB SETTINGS
ADB_HOST=
ADB_PORT=
ADB_CONNECT_RETRIES=

# FRIDA SETTINGS
FRIDA_HOST=
FRIDA_PORT=

# SUPABASE SETTINGS
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# RABBIT
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_MANAGMENT_PORT=
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_URL=
RABBITMQ_EVENTS_QUEUE=

# USERS
# Auto-upload finished collect tasks to Supabase (true/false, default true)
USERS_AUTOSYNC=

# Viber configuration
VIBER_DEFAULT_PHONE=
VIBER_DEFAULT_COUNTRY=

# SOCKS5 / HTTP Proxy (routes emulator outbound traffic through proxy)
PROXY_HOST=
PROXY_PORT=50101
PROXY_USER=
PROXY_PASS=
PROXY_TYPE=socks5

