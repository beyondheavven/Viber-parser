# ---- Server ----
PORT=

# ---- ADB ----
# The instance is reachable here once ADB debugging is enabled in its settings.
# LDPlayer also exposes the same instance as emulator-5554; pin one and stay on it.
ANDROID_SERIAL=
# Leave empty to use %ANDROID_HOME%\platform-tools\adb.exe
ADB_BIN=
ADB_EXEC_TIMEOUT=

# ---- Appium ----
APPIUM_HOST=
APPIUM_PORT=
APPIUM_NEW_COMMAND_TIMEOUT=
UI_WAIT_TIMEOUT=
ANDROID_INSTALL_TIMEOUT=

# ---- Viber ----
VIBER_PACKAGE=
VIBER_ACTIVITY=
VIBER_MESSAGES_DB=

# ---- Monitor ----
MONITOR_POLL_INTERVAL=
MONITOR_STORE=

# ---- Monitor webhook ----
# Leave MONITOR_WEBHOOK_URL empty to disable pushing; the monitor then only
# logs and appends to MONITOR_STORE.
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_SECRET=
MONITOR_WEBHOOK_TIMEOUT=
MONITOR_WEBHOOK_RETRIES=
MONITOR_WEBHOOK_RETRY_DELAY=
MONITOR_WEBHOOK_DEAD_LETTER=
MONITOR_WEBHOOK_INCOMING_ONLY=true
